# Hifazat — Environment Variables
# Copy to .env and fill in values

# SQLite database path for approval queue
# Defaults to ./hifazat_approvals.db if not set
APPROVAL_DB_PATH=./hifazat_approvals.db

# Gemini API key (required for real LLM calls, optional for stub mode)
GEMINI_API_KEY=
# Model identifier — default gemini-2.5-flash, override for newer models
GEMINI_MODEL=gemini-2.5-flash

# Whisper model size for STT (small recommended for Urdu on CPU)
WHISPER_MODEL_SIZE=small

# MMS-TTS model for Urdu voice output (default: facebook/mms-tts-urd-script_arabic)
MMS_TTS_MODEL=facebook/mms-tts-urd-script_arabic

# Green API (WhatsApp)
# Get these from https://green-api.com dashboard after QR-linking your phone
GREEN_API_ID_INSTANCE=
GREEN_API_TOKEN_INSTANCE=

# Webhook security token — long random string.
# Set this as the path segment in your webhook URL: /webhooks/whatsapp/{this_value}
# Also set as webhookUrlToken in Green API instance settings.
# Returns 404 on mismatch (don't reveal the route exists).
GREENAPI_WEBHOOK_TOKEN=

# Public base URL for serving TTS audio files
# Green API needs a publicly reachable URL to fetch audio.
# Set to your deployment URL (e.g. https://hifazat.onrender.com)
# No trailing slash. No host-specific logic in the code.
PUBLIC_BASE_URL=

# Demo day — Sandbox join-code plan:
# Option A: Pre-join judges' phones to Sandbox before demo
# Option B: Demo on a pre-joined phone, judges watch
# Decision: ________ (fill in before demo day)

# Reviewer Dashboard Auth (Day 6)
# Used for /login — one shared credential, not multi-user
# Sessions are in-memory — lost on restart/Render sleep (accepted trade-off)
REVIEWER_USERNAME=reviewer
REVIEWER_PASSWORD=

# Dev/testing API ingress gate (Day 6)
# POST /messages returns 404 when this is not 'true'
# Prevents pipeline abuse on deployed instances
ENABLE_DEV_INGRESS=false

